---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleContents from '../../components/ArticleContents.astro';
import EditorialPicture from '../../components/EditorialPicture.astro';
import PostCard from '../../components/PostCard.astro';
import { posts, getCategory, getSection } from '../../lib/data';
import { prepareArticle } from '../../lib/article-headings.mjs';
import { articleMedia } from '../../lib/editorial-context';
export function getStaticPaths(){return posts.map((post)=>({params:{post:post.slug},props:{post}}))}
const { post }=Astro.props;
const blocks=post.body.split(/\n\s*\n/).filter(Boolean);
const isHtml=post.body_format==='html';
const escapeHtml = (text: string) => text.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
const prepared = prepareArticle(isHtml ? post.body : blocks.map(block => block.startsWith('## ') ? `<h2>${escapeHtml(block.slice(3))}</h2>` : `<p>${escapeHtml(block.replaceAll('\n',' '))}</p>`).join('\n'));
const category = getCategory(post.category_slug);
const section = getSection(post.section_slug);
const photo = articleMedia(post.slug);
const related = (post.related_posts || []).map(slug => posts.find(item => item.slug === slug && item.slug !== post.slug)).filter(Boolean).slice(0,3);
const words = prepared.html.replace(/<[^>]*>/g,' ').split(/\s+/).filter(Boolean).length;
---
<Layout title={post.title} description={post.seo_description || post.excerpt} canonical={`/post/${post.slug}/`}>
  <article class="page reading-page">
    <Breadcrumbs items={[{label:'Home',href:'/'},...(section ? [{label:section.name,href:`/section/${section.slug}/`}] : []),...(category ? [{label:category.name,href:`/category/${category.slug}/`}] : [])]} />
    <header class="article-heading"><p class="eyebrow">{category?.name || 'Field notes'}</p><h1>{post.title}</h1><p class="meta">Published <time datetime={post.published}>{post.published}</time> · {Math.max(1,Math.ceil(words/220))} min read</p></header>
    {photo && <div class:list={['article-photo',{'portrait':photo === 'chiang-mai'}]}><EditorialPicture assetId={photo} priority sizes="(max-width: 768px) 100vw, (max-width: 1440px) 90vw, 1320px" /></div>}
    <div class:list={['reading-grid', { 'without-contents': prepared.headings.length === 0 }]}><ArticleContents headings={prepared.headings}/><div class="article-body" set:html={prepared.html}></div></div>
    {related.length > 0 && <section class="related"><p class="eyebrow">Continue exploring</p><h2>More from the field notes</h2><div class="post-grid">{related.map(item => <PostCard post={item}/>)}</div></section>}
  </article>
</Layout>
<style>
  .reading-grid.without-contents{grid-template-columns:minmax(0,44rem);justify-content:center}
  .article-heading{max-width:58rem;margin:0 auto 3rem;text-align:center}h1{font-family:var(--font-heading,'Playfair Display',Georgia,serif);font-size:clamp(2.6rem,5vw,5.1rem);font-weight:500;line-height:1.08;letter-spacing:-.04em;margin:1rem 0 1.5rem;text-wrap:balance}.article-photo{margin:0 0 4rem}.article-photo :global(img){max-height:none;aspect-ratio:auto;object-fit:contain}.article-photo.portrait{max-width:40rem;margin-left:auto;margin-right:auto}.article-photo.portrait :global(img){max-height:none;aspect-ratio:auto}.reading-grid{display:grid;grid-template-columns:15rem minmax(0,44rem);gap:clamp(3rem,7vw,7rem);align-items:start}.article-body{font-size:1.125rem;line-height:1.8;overflow-wrap:anywhere;min-width:0}.article-body :global(p){margin:0 0 1.5rem}.article-body :global(h2){font-family:var(--font-heading,'Playfair Display',Georgia,serif);font-size:1.7rem;line-height:1.3;font-weight:500;margin:2.8rem 0 1.2rem;scroll-margin-top:7rem}.article-body :global(a){text-decoration:underline;text-decoration-color:#8b9c91;text-underline-offset:.2em}.article-body :global(li){margin:.5rem 0}.article-body :global(table){display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;font-size:.9rem}.article-body :global(td),.article-body :global(th){padding:.75rem;border-bottom:1px solid var(--line,#d8dcd2);text-align:left;vertical-align:top}.article-body :global(img){max-width:100%;height:auto}.related{margin-top:6rem;padding-top:3rem;border-top:1px solid var(--line,#d8dcd2)}.related>h2{font-family:var(--font-heading,'Playfair Display',Georgia,serif);font-size:clamp(2rem,3vw,3rem);font-weight:500;margin:1rem 0 2rem}@media(max-width:900px){.reading-grid{grid-template-columns:1fr;gap:2rem}.article-body{max-width:44rem;margin:0 auto}.article-heading{text-align:left}.article-photo{margin-bottom:2.5rem}.related{margin-top:4rem}}@media(max-width:600px){.article-photo :global(img){aspect-ratio:auto}.article-photo.portrait :global(img){aspect-ratio:auto}}
</style>
