---
import Layout from '../layouts/Layout.astro';
import EditorialPicture from '../components/EditorialPicture.astro';
import { site, sections, posts } from '../lib/data';
import { sectionDescriptions } from '../lib/editorial-context';
import copy from '../../docs/redesign/20261013/copy-lock.json';
const destinations = [
 { id:'bangkok', slug:'bangkok-first-timer-guide', label:'Bangkok', description:'Find your base and connect the city’s neighborhoods.' },
 { id:'chiang-mai', slug:'chiang-mai-first-timer-guide', label:'Chiang Mai', description:'Make room for the old city and the surrounding north.' },
 { id:'krabi', slug:'krabi-travel-guide', label:'Krabi', description:'Choose a coastal base that fits the way you travel.' },
].map(item => ({...item, post:posts.find(post => post.slug === item.slug)}));
---
<Layout title={site.site_name} description={copy.home.lead}>
 <div class="page home-page">
  <section class="home-hero" aria-labelledby="home-title">
   <div class="hero-copy"><h1 id="home-title">{copy.home.h1}</h1><p class="lede">{copy.home.lead}</p><a class="button" href={copy.home.cta.href}>{copy.home.cta.label}<span class="arrow" aria-hidden="true">→</span></a></div>
   <div class="hero-media"><EditorialPicture assetId="home-railay" priority sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1100px) 52vw, 726px" /><p class="photo-caption">{copy.home.photoCaption}</p></div>
  </section>
  <section class="journey-section" aria-labelledby="journey-title"><h2 id="journey-title">{copy.home.headings[0]}</h2><div class="section-index">
   {sections.map((section,index) => <article class="index-entry"><span class="index-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><h3><a href={`/section/${section.slug}/`}>{section.name}</a></h3><p>{sectionDescriptions[section.slug]}</p><a class="explore" href={`/section/${section.slug}/`} aria-label={`Explore ${section.name}`}>Explore <span class="arrow" aria-hidden="true">→</span></a></article>)}
  </div></section>
  <section class="destinations-section" aria-labelledby="destinations-title"><h2 id="destinations-title">{copy.home.headings[1]}</h2><div class="destination-grid">
   {destinations.map(item => item.post && <article class:list={['destination-preview',item.id]}><EditorialPicture assetId={item.id} sizes={item.id === 'bangkok' ? '(max-width: 760px) calc(100vw - 40px), 50vw' : '(max-width: 760px) calc(100vw - 40px), 25vw'} /><h3><a href={`/post/${item.post.slug}/`}>{item.post.title}</a></h3><p>{item.description}</p><a class="destination-link" href={`/post/${item.post.slug}/`} aria-label={`Read about ${item.label}`}><span class="arrow" aria-hidden="true">→</span></a></article>)}
  </div></section>
 </div>
</Layout>
<style>
 .home-page{padding-top:32px}.home-hero{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1fr);gap:48px;align-items:center;padding-bottom:48px;border-bottom:1px solid var(--line)}.hero-copy{padding-block:24px}.hero-copy h1{font-size:clamp(54px,6.5vw,94px);line-height:1.04;letter-spacing:-.062em;margin:0 0 32px}.hero-copy .lede{font-size:clamp(19px,1.9vw,27px);line-height:1.5;color:var(--green);margin-bottom:40px;max-width:28ch}.hero-media{min-width:0}.hero-media :global(img){width:100%;height:auto;aspect-ratio:1.06;object-fit:cover}.photo-caption{font-size:13px;color:var(--muted);padding-top:8px;margin:0}.journey-section{padding-block:var(--section-space);border-bottom:1px solid var(--line)}.home-page h2{font-size:clamp(34px,4.5vw,62px);letter-spacing:-.045em;margin:0 0 48px}.section-index{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}.index-entry{min-width:0;padding-inline:28px;border-left:1px solid var(--line);display:flex;flex-direction:column;align-items:flex-start}.index-entry:first-child{padding-left:0;border-left:0}.index-entry:last-child{padding-right:0}.index-number{font:400 48px/1.1 var(--serif);letter-spacing:-.05em;color:var(--terracotta)}.index-entry h3{font-size:29px;letter-spacing:-.035em;margin:16px 0 20px}.index-entry h3 a{text-decoration:none}.index-entry p{font-size:16px;line-height:1.65;color:var(--muted);margin-bottom:24px}.explore{display:inline-flex;gap:16px;align-items:center;min-height:44px;margin-top:auto;color:var(--terracotta);font-size:12px;letter-spacing:.14em;text-transform:uppercase;text-decoration:none}.destinations-section{padding-top:var(--section-space)}.destination-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:24px;align-items:stretch}.destination-preview{min-width:0;position:relative;display:flex;flex-direction:column}.destination-preview :global(img){width:100%;height:360px;object-fit:cover}.destination-preview.chiang-mai :global(img){height:360px;object-fit:contain;background:var(--sage)}.destination-preview h3{font-size:26px;letter-spacing:-.03em;margin:18px 0 12px}.destination-preview h3 a{text-decoration:none}.destination-preview h3 a:hover{text-decoration:underline}.destination-preview p{font-size:15px;line-height:1.65;color:var(--muted);padding-right:28px;margin-bottom:0}.destination-link{display:inline-flex;align-items:center;justify-content:flex-end;min-width:44px;min-height:44px;color:var(--terracotta);text-decoration:none;align-self:flex-end;margin-top:auto}.destination-link .arrow{font-size:25px}@media(max-width:1100px){.home-hero{gap:32px}.hero-copy h1{font-size:clamp(50px,6.6vw,76px)}.index-entry{padding-inline:20px}.index-entry h3{font-size:25px}.destination-preview :global(img),.destination-preview.chiang-mai :global(img){height:300px}}@media(max-width:900px){.section-index{grid-template-columns:1fr 1fr;gap:36px 0}.index-entry:nth-child(3){padding-left:0;border-left:0}.index-entry:nth-child(2){padding-right:0}.destination-grid{gap:20px}.destination-preview h3{font-size:23px}}@media(max-width:760px){.home-hero{grid-template-columns:1fr;gap:32px;padding-bottom:40px}.hero-copy{padding:8px 0 0}.hero-copy h1{font-size:clamp(52px,10vw,76px);max-width:10ch;margin-bottom:24px}.hero-copy .lede{max-width:30ch;font-size:20px;margin-bottom:28px}.hero-media :global(img){aspect-ratio:1.15}.home-page h2{margin-bottom:32px}.destination-grid{grid-template-columns:1fr;gap:36px}.destination-preview :global(img){height:auto;aspect-ratio:1.45}.destination-preview.chiang-mai :global(img){height:auto;aspect-ratio:2/3}.destination-preview h3{font-size:28px}.destination-preview p{max-width:46ch}.destination-link{position:absolute;right:0;bottom:0}.index-entry h3{font-size:24px}}@media(max-width:450px){.section-index{grid-template-columns:1fr;gap:0}.index-entry,.index-entry:first-child,.index-entry:nth-child(3){padding:24px 0;border-left:0;border-top:1px solid var(--line);display:grid;grid-template-columns:48px 1fr;column-gap:20px}.index-number{font-size:38px;grid-row:1/4}.index-entry h3{margin:0 0 12px}.index-entry p{margin-bottom:8px}.explore{grid-column:2}.home-page h2{font-size:36px}.hero-copy h1{font-size:56px}}
</style>
