---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { sections, getPostsForSection } from '../../lib/data';
export function getStaticPaths(){return sections.map((section)=>({params:{section:section.slug},props:{section}}))}
const { section } = Astro.props; const posts = getPostsForSection(section.slug);
---
<Layout title={section.name} description={`Thailand Field Notes guides in ${section.name}`}><div class="page"><section class="hero"><p class="eyebrow">Section</p><h1>{section.name}</h1><p class="lede">A practical starting point for first-time independent travelers.</p></section><div class="grid">{posts.map((post)=><PostCard post={post}/>)}</div></div></Layout>
