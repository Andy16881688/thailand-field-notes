---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ArticleContents from './ArticleContents.astro';
const { page } = Astro.props;
const blocks = page.body.split(/\n\s*\n/).filter(Boolean);
let headingIndex = 0;
const content = blocks.map(block => block.startsWith('### ') ? { heading: true, text: block.slice(4), id: `policy-${++headingIndex}` } : { heading: false, text: block.replaceAll('\n', ' ') });
const headings = content.filter(block => block.heading).map(block => ({ id: block.id, text: block.text }));
---
<Layout title={page.title} description={`${page.title} — Thailand Field Notes.`} canonical={page.route}>
  <article class="page legal-page">
    <Breadcrumbs items={[{label:'Home',href:'/'},{label:page.title}]} />
    <header class="legal-heading"><p class="eyebrow">Thailand Field Notes</p><h1>{page.title}</h1></header>
    <div class="legal-grid"><ArticleContents headings={headings}/><div class="legal-body">{content.map(block => block.heading ? <h2 id={block.id}>{block.text}</h2> : <p>{block.text}</p>)}</div></div>
  </article>
</Layout>
<style>
  .legal-heading{max-width:54rem;margin-bottom:4rem}
  h1{font-family:var(--font-heading,'Playfair Display',Georgia,serif);font-size:clamp(2.6rem,6vw,5rem);font-weight:500;line-height:1.1;letter-spacing:-.04em;margin:1rem 0}
  .legal-grid{display:grid;grid-template-columns:15rem minmax(0,44rem);gap:clamp(3rem,7vw,7rem)}
  .legal-body{overflow-wrap:anywhere}
  .legal-body p{font-size:1.0625rem;line-height:1.8;margin:0 0 1.5rem}
  .legal-body h2{font-family:var(--font-heading,'Playfair Display',Georgia,serif);font-weight:500;font-size:1.55rem;line-height:1.3;margin:2.5rem 0 1rem;scroll-margin-top:7rem}
  .legal-body h2:first-child{margin-top:0}
  @media(max-width:900px){.legal-heading{margin-bottom:2rem}.legal-grid{grid-template-columns:1fr;gap:2rem}.legal-body{max-width:44rem}}
</style>
