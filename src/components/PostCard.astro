---
import EditorialPicture from './EditorialPicture.astro';
import { articleMedia } from '../lib/editorial-context';
const { post } = Astro.props;
const assetId = articleMedia(post.slug);
// A missing subject match deliberately produces a text-led preview, never an old hero.
const description = String(post.seo_description || '').trim();
const excerpt = description.length <= 260 && /[.!?]$/.test(description) ? description : '';
---
<article class="post-preview">
  {assetId && <EditorialPicture assetId={assetId} sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 900px) 45vw, 400px" />}
  <p class="eyebrow">{String(post.category_slug || '').replaceAll('-', ' ')}</p>
  <h3><a href={`/post/${post.slug}/`}>{post.title}</a></h3>
  {excerpt && <p class="preview-excerpt">{excerpt}</p>}
  {post.published && <p class="meta">Published <time datetime={post.published}>{post.published}</time></p>}
  <a class="read-note" href={`/post/${post.slug}/`} aria-label={`Read ${post.title}`}>Read field note <span class="arrow" aria-hidden="true">→</span></a>
</article>
<style>
 .post-preview{min-width:0;border-top:1px solid var(--line);padding-top:24px;display:flex;flex-direction:column;align-items:flex-start}.post-preview :global(.editorial-picture){width:100%;margin-bottom:24px}.post-preview h3{font-size:clamp(25px,2.4vw,32px);margin:4px 0 20px}.post-preview h3 a{text-decoration:none}.post-preview h3 a:hover{text-decoration:underline}.preview-excerpt{font-size:16px;line-height:1.7;color:var(--muted)}.read-note{font-size:13px;min-height:44px;display:inline-flex;gap:20px;align-items:center;text-decoration:none;color:var(--terracotta);margin-top:auto}.meta{margin-bottom:12px}
</style>
