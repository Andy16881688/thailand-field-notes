---
import { site, sections } from '../lib/data';
const { title = site.site_name, description = site.tagline, canonical = Astro.url.pathname } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | {site.site_name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href="/assets/stitch-fonts/font-face-1042869150.css" />
    <link rel="stylesheet" href="/assets/stitch-fonts/font-face-119028504.css" />
    <link rel="stylesheet" href="/assets/stitch-fonts/font-face-1835608007.css" />
    <link rel="stylesheet" href="/assets/stitch-fonts/font-face-2025698732.css" />
    <link rel="stylesheet" href="/assets/stitch-fonts/font-face-497168148.css" />
    <link rel="stylesheet" href="/assets/stitch-fonts/font-face-658239174.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">Thailand Field Notes</a>
      <nav aria-label="Primary navigation">
        {sections.map((section) => <a href={`/section/${section.slug}/`}>{section.name}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>Practical routes, local context, and travel updates for Thailand.</p>
      <nav aria-label="Legal navigation"><a href="/about/">About</a><a href="/privacy-policy/">Privacy Policy</a><a href="/terms/">Terms</a><a href="/user-agreement/">User Agreement</a></nav>
    </footer>
  </body>
</html>
<style is:global>
  :root{--paper:#fdfbf7;--ink:#1a1a1a;--terracotta:#c05640;--sage:#e8f0e8;--line:#d9d5cc;font-family:Inter,Arial,sans-serif;color:var(--ink);background:var(--paper)}
  *{box-sizing:border-box}body{margin:0;background:var(--paper);line-height:1.65}a{color:inherit;text-decoration:none}a:hover{color:var(--terracotta)}
  .site-header{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.4rem clamp(1rem,4vw,4rem);border-bottom:1px solid var(--line);position:sticky;top:0;background:color-mix(in srgb,var(--paper) 94%,transparent);z-index:2}.wordmark{font-family:'Playfair Display',Georgia,serif;font-size:1.35rem;font-weight:700}.site-header nav,.site-footer nav{display:flex;gap:1rem;flex-wrap:wrap;font-size:.86rem}.site-footer{margin-top:5rem;padding:2rem clamp(1rem,4vw,4rem);border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.85rem;color:#5c5b56}
  .page{max-width:1120px;margin:0 auto;padding:clamp(2rem,6vw,5rem) clamp(1rem,4vw,3rem)}.eyebrow{color:var(--terracotta);text-transform:uppercase;letter-spacing:.16em;font-size:.72rem;font-weight:700}.hero{max-width:760px}.hero h1,.article h1{font-family:'Playfair Display',Georgia,serif;font-size:clamp(2.4rem,6vw,5.8rem);line-height:1.02;margin:.7rem 0 1.2rem}.lede{font-size:1.15rem;color:#5c5b56;max-width:650px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin-top:2rem}.card{border:1px solid var(--line);padding:1.2rem;background:#fffdf9;min-height:170px}.card h2,.card h3{font-family:'Playfair Display',Georgia,serif;line-height:1.15}.card img,.article img{width:100%;display:block;object-fit:cover}.card img{aspect-ratio:16/9;margin-bottom:1rem}.button{display:inline-block;background:var(--terracotta);color:#fff;padding:.7rem 1rem;margin-top:1rem}.article{max-width:780px;margin:0 auto;min-width:0}.article .hero-image,.article .closing-image{max-height:520px;margin:2rem 0}.article h2{font-family:'Playfair Display',Georgia,serif;font-size:1.8rem;line-height:1.2;margin-top:2.2rem}.article p,.article li{font-size:1.05rem}.article-body{overflow-wrap:anywhere;word-break:break-word}.meta{font-size:.85rem;color:#686761}.legal{max-width:780px}.legal h1{font-family:'Playfair Display',Georgia,serif;font-size:clamp(2.5rem,5vw,4.5rem);line-height:1.05}.legal h2{font-family:'Playfair Display',Georgia,serif;margin-top:2rem}
  @media(max-width:720px){.site-header{display:block}.site-header nav{margin-top:1rem;min-width:0;max-width:100%;overflow-x:auto;overflow-y:hidden;flex-wrap:nowrap}.site-header nav a{white-space:nowrap}.site-footer{display:block}.site-footer nav{margin-top:1rem}}
</style>
